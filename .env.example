# Bắt buộc
DISCORD_TOKEN=thay_token_bot_tai_day
SUPPORT_ROLE_ID=123456789012345678
CITIZEN_ROLE_ID=234567890123456789
NEW_CITIZEN_ROLE_ID=345678901234567890

# Link hiện trong tin chào mừng
RULES_URL=https://discord.com/channels/ID_SERVER/ID_KENH_LUAT
WHITELIST_URL=https://discord.com/channels/ID_SERVER/ID_KENH_WHITELIST
WELCOME_IMAGE_URL=https://example.com/welcome-banner.png
TICKET_IMAGE_URL=https://example.com/ticket-banner.png

# Đổi IP_VPS_CUA_BAN thành IP public hoặc domain VPS để mở link transcript.
PUBLIC_BASE_URL=http://IP_VPS_CUA_BAN:5000
WEB_HOST=0.0.0.0
WEB_PORT=5000

# Transcript HTML và file đính kèm lưu trên VPS, tự xóa sau 15 ngày.
TRANSCRIPT_RETENTION_DAYS=15
MAX_ATTACHMENT_MB=25
COMMAND_PREFIX=+

